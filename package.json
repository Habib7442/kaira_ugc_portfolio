{
  "name": "behind-the-post",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Behind the Post: a 3D scroll portfolio template for UGC creators",
  "scripts": {
    "dev": "vite",
    "dev:test": "cross-env CREATOR=src/content/test-creator.json vite",
    "assets": "node scripts/assets.mjs",
    "check-content": "node scripts/check-content.mjs",
    "media-kit": "node scripts/media-kit.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/check-content.mjs && tsc --noEmit && vite build && node scripts/size-report.mjs",
    "build:test": "cross-env CREATOR=src/content/test-creator.json npm run build",
    "preview": "vite preview --host",
    "report": "node scripts/size-report.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "cross-env": "^10.0.0",
    "lighthouse": "^12.8.2",
    "puppeteer-core": "^25.13.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.0",
    "vite": "^8.3.4"
  }
}
